  "dct:conformsTo": "https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE/",
  "@id": "scconnect-biocypher-adapter",
  "name": "scConnect BioCypher Adapter",
  "description": "BioCypher adapter for metabolite and inorganic ligand–target interactions distributed with scConnect. Combines ligand annotations with interaction records, maps PubChem compound identifiers to HMDB accessions, and emits metabolite-to-protein association edges with interaction modes and supporting PubMed references.",
  "version": "0.1.0",
  "license": "https://www.gnu.org/licenses/gpl-3.0.html",
  "codeRepository": "https://github.com/biocypher/metalinks",
  "creator": [
    {
      "@type": "Person",
      "name": "Elias Farr",
      "affiliation": "University Hospital Heidelberg",
      "url": "https://github.com/EliasFarr",
      "identifier": "https://orcid.org/0000-0002-4441-6513"
    }
  ],
  "keywords": [
    "BioCypher",
    "scConnect",
    "ligand",
    "metabolite",
    "protein",
    "pharmacology",
    "HMDB",
    "UniProt"
  ],
  "hasPart": [
    {
      "@type": "sc:Dataset",
      "name": "scConnect ligands",
      "description": "Ligand annotations from the IUPHAR/BPS Guide to PHARMACOLOGY, distributed as the cleaned 2020-5 table in scConnect. Contains 10,659 records with ligand names, chemical categories, database identifiers and molecular structures. The adapter uses entries classified as Metabolite or Inorganic with a PubChem compound identifier. The publication date records the distributed table’s public commit date.",
      "conformsTo": "http://mlcommons.org/croissant/1.0",
      "citeAs": "Armstrong, J. F., et al. (2020). The IUPHAR/BPS Guide to PHARMACOLOGY in 2020: extending immunopharmacology content and introducing the IUPHAR/MMV Guide to MALARIA PHARMACOLOGY. Nucleic Acids Research, 48(D1), D1006–D1021. https://doi.org/10.1093/nar/gkz951\n\nJakobsson, J. E. T., Spjuth, O., & Lagerström, M. C. (2021). scConnect: a method for exploratory analysis of cell–cell communication based on single-cell RNA-sequencing data. Bioinformatics, 37(20), 3501–3508. https://doi.org/10.1093/bioinformatics/btab245",
      "creator": [
        {
          "@type": "sc:Organization",
          "name": "IUPHAR/BPS Guide to PHARMACOLOGY",
          "url": "https://www.guidetopharmacology.org/"
        }
      ],
      "datePublished": "2021-01-25T00:00:00Z",
      "license": "CC-BY-4.0",
      "url": "https://github.com/JonETJakobsson/scConnect/tree/master/scConnect/data/GTP_tables_clean/2020-5",
      "version": "2020-5",
