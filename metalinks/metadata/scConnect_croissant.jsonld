    {
      "@type": "sc:Dataset",
      "name": "HMDB mappings",
      "description": "Lookup table associating HMDB accessions with PubChem, KEGG and ChEBI identifiers. Contains 217,920 records. The scConnect adapter uses PubChem compound identifiers to look up HMDB accessions. Version and publication date identify the file’s Git revision and public commit date. Elias Farr is credited for the repository contribution; the exact generation procedure and original database snapshot are undocumented.",
      "conformsTo": "http://mlcommons.org/croissant/1.0",
      "citeAs": "Elias Farr. (2023). HMDB mappings [Data set].",
      "creator": [
