    {
      "@type": "sc:Dataset",
      "name": "scConnect interactions",
      "description": "Ligand–target interaction records derived from the Guide to PHARMACOLOGY tables distributed with scConnect. Contains 20,289 records covering multiple species, with target identifiers, interaction classifications and PubMed references. The adapter input differs from scConnect’s cleaned 2020-5 table in target UniProt mappings and row expansion. Version and publication date identify the input CSV’s Git revision and public commit date.",
      "conformsTo": "http://mlcommons.org/croissant/1.0",
      "citeAs": "Armstrong, J. F., et al. (2020). The IUPHAR/BPS Guide to PHARMACOLOGY in 2020: extending immunopharmacology content and introducing the IUPHAR/MMV Guide to MALARIA PHARMACOLOGY. Nucleic Acids Research, 48(D1), D1006–D1021. https://doi.org/10.1093/nar/gkz951\n\nJakobsson, J. E. T., Spjuth, O., & Lagerström, M. C. (2021). scConnect: a method for exploratory analysis of cell–cell communication based on single-cell RNA-sequencing data. Bioinformatics, 37(20), 3501–3508. https://doi.org/10.1093/bioinformatics/btab245",
      "creator": [
        {
          "@type": "sc:Organization",
          "name": "IUPHAR/BPS Guide to PHARMACOLOGY",
          "url": "https://www.guidetopharmacology.org/"
        }
      ],
      "datePublished": "2024-03-31T00:00:00Z",
      "license": "CC-BY-4.0",
      "url": "https://github.com/JonETJakobsson/scConnect/tree/master/scConnect/data/GTP_tables_clean/2020-5",
      "version": "d8ec00164264348e89d9b249d03378cd625a5875",
