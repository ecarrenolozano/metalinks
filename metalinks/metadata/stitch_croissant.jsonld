  "@type": "SoftwareSourceCode",
  "componentType": "adapter",
  "dct:conformsTo": "https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE/",
  "@id": "stitch-biocypher-adapter",
  "name": "STITCH BioCypher Adapter",
  "description": "BioCypher adapter for human chemical–protein interactions from STITCH 5.0, used by the MetaLinks pipeline. Reads interaction actions and detailed evidence scores from archived STITCH tables hosted on Zenodo. Filters interactions and uses HMDB and Ensembl-to-UniProt mappings retrieved through pypath to normalize identifiers. Produces metabolite–protein edges with interaction modes and evidence scores for integration into the MetaLinks knowledge graph.",
  "version": "0.1.0",
  "license": "https://www.gnu.org/licenses/gpl-3.0.html",
  "codeRepository": "https://github.com/biocypher/metalinks",
  "creator": [
    {
      "@type": "Person",
      "name": "Elias Farr",
      "affiliation": "University Hospital Heidelberg",
      "url": "https://github.com/EliasFarr"
    }
  ],
  "keywords": [
    "biocypher",
    "metabolomics",
    "metalinks"
  ],
  "hasPart": [
    {
      "@type": "sc:Dataset",
      "name": "STITCH human interaction actions — archived snapshot",
      "description": "Human STITCH 5.0 chemical–protein interaction actions, including interaction mode, action, direction indicator, and confidence score. This snapshot is archived in Zenodo record 10200150, published on 2023-11-23. Its uncompressed contents match the original STITCH download.",
      "conformsTo": "http://mlcommons.org/croissant/1.0",
      "citeAs": "@article{10.1093/nar/gkv1277,\r\n    author = {Szklarczyk, Damian and Santos, Alberto and von Mering, Christian and Jensen, Lars Juhl and Bork, Peer and Kuhn, Michael},\r\n    title = {STITCH 5: augmenting protein–chemical interaction networks with tissue and affinity data},\r\n    journal = {Nucleic Acids Research},\r\n    volume = {44},\r\n    number = {D1},\r\n    pages = {D380-D384},\r\n    year = {2016},\r\n    month = {01},\r\n    abstract = {Interactions between proteins and small molecules are an integral part of biological processes in living organisms. Information on these interactions is dispersed over many databases, texts and prediction methods, which makes it difficult to get a comprehensive overview of the available evidence. To address this, we have developed STITCH (‘Search Tool for Interacting Chemicals’) that integrates these disparate data sources for 430 000 chemicals into a single, easy-to-use resource. In addition to the increased scope of the database, we have implemented a new network view that gives the user the ability to view binding affinities of chemicals in the interaction network. This enables the user to get a quick overview of the potential effects of the chemical on its interaction partners. For each organism, STITCH provides a global network; however, not all proteins have the same pattern of spatial expression. Therefore, only a certain subset of interactions can occur simultaneously. In the new, fifth release of STITCH, we have implemented functionality to filter out the proteins and chemicals not associated with a given tissue. The STITCH database can be downloaded in full, accessed programmatically via an extensive API, or searched via a redesigned web interface at http://stitch.embl.de.},\r\n    issn = {0305-1048},\r\n    doi = {10.1093/nar/gkv1277},\r\n    url = {https://doi.org/10.1093/nar/gkv1277},\r\n    eprint = {https://academic.oup.com/nar/article-pdf/44/D1/D380/9483631/gkv1277.pdf},\r\n}",
      "creator": [
        {
          "@type": "sc:Organization",
          "name": "STITCH Consortium"
        }
      ],
      "datePublished": "2023-11-23T00:00:00Z",
      "license": "CC-BY-4.0",
      "url": "https://stitch-db.org/cgi/download.pl?species_text=Homo+sapiens",
      "version": "5.0",
