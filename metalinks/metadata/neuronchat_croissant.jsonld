  "@id": "neuronchat-biocypher-adapter",
  "name": "NeuronChat BioCypher Adapter",
  "description": "BioCypher adapter for human neurotransmitter and gas-signaling interactions from NeuronChatDB. Maps ligand names to HMDB identifiers and target gene symbols to UniProt accessions, with fallback identifier mappings where needed, and emits metabolite-to-protein association edges.",
  "version": "0.1.0",
