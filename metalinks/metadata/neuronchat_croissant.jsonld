    {
      "@type": "sc:Dataset",
      "name": "NeuronChat ligand-to-HMDB mappings",
      "description": "Lookup table connecting NeuronChat ligand names to HMDB identifiers, with chemical names, PubChem, ChEBI, KEGG and METLIN fields, and SMILES strings. Contains 11 records. Version and publication date identify the file’s Git revision and public commit date. Elias Farr is credited for the repository contribution; original mapping sources are undocumented. Chemical forms may differ across identifier columns.",
      "conformsTo": "http://mlcommons.org/croissant/1.0",
      "citeAs": "Elias Farr. (2023). NeuronChat ligand-to-HMDB mappings [Data set].",
      "creator": [
        {
          "@type": "sc:Person",
          "name": "Elias Farr",
          "affiliation": "University Hospital Heidelberg",
          "identifier": "https://orcid.org/0000-0002-4441-6513",
          "url": "https://github.com/EliasFarr"
        }
      ],
      "datePublished": "2023-07-11T00:00:00Z",
      "license": "No license",
      "url": "https://github.com/biocypher/metalinks/tree/main/data/mapping_tables",
      "version": "616f2c68bd276119cc4398ed4fb8a0f90e392e1a",
      "distribution": [
        {
          "@type": "cr:FileObject",
