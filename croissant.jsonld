  "@type": "SoftwareSourceCode",
  "name": "MetaLinks BioCypher adapter",
  "description": "Integrates human protein–chemical interactions and metabolite identifier mappings for MetaLinksDB knowledge graph generation.",
  "version": "0.0.2",
  "license": "https://github.com/yasfazl/metalinks/blob/main/LICENSE",
  "codeRepository": "https://github.com/yasfazl/metalinks",
  "creator": {
    "@type": "Person",
    "name": "Elias Farr",
    "url": "https://github.com/EliasFarr"
  },
  "keywords": [
    "BioCypher",
    "MetaLinksDB",
    "STITCH",
    "knowledge graph"
  ],
  "hasPart": {
    "@type": "Dataset",
    "name": "Offline resource for metalinks KG generation",
    "description": "Three source files consumed by the protein–chemical interaction adapter.",
    "url": "https://zenodo.org/records/10200150",
    "conformsTo": "http://mlcommons.org/croissant/1.0",
    "distribution": [
      {
        "@type": "cr:FileObject",
        "@id": "#ACTIONS_PATH",
        "name": "9606.actions.v5.0.tsv",
        "description": "Adapter input mapped to ACTIONS_PATH.",
        "contentUrl": "https://zenodo.org/records/10200150/files/9606.actions.v5.0.tsv?download=1",
        "encodingFormat": "text/tab-separated-values",
        "md5": "26eddaa0f8c4ab46a0da8ee6ece9aed2"
      },
      {
        "@type": "cr:FileObject",
        "@id": "#DETAILS_PATH",
        "name": "9606.protein_chemical.links.detailed.v5.0.tsv",
        "description": "Adapter input mapped to DETAILS_PATH.",
        "contentUrl": "https://zenodo.org/records/10200150/files/9606.protein_chemical.links.detailed.v5.0.tsv?download=1",
        "encodingFormat": "text/tab-separated-values",
        "md5": "7b768c8b21e60e42e17a84c07097bbf9"
      },
      {
        "@type": "cr:FileObject",
        "@id": "#METMAP_PATH",
        "name": "metmap_curated.csv",
        "description": "Adapter input mapped to METMAP_PATH.",
        "contentUrl": "https://zenodo.org/records/10200150/files/metmap_curated.csv?download=1",
        "encodingFormat": "text/tab-separated-values",
        "md5": "879b2339270432476520399aa55da402"
      }
    ],
    "version": "v1",
    "license": "NOASSERTION",
    "datePublished": "2023-11-23",
    "citeAs": "https://doi.org/10.5281/zenodo.10200150",
    "creator": {
      "@type": "Person",
      "name": "Elias Farr"
    },
    "recordSet": [
      {
        "@type": "cr:RecordSet",
        "@id": "actions",
        "name": "actions",
        "description": "STITCH interaction actions. The action column may be blank.",
        "field": [
          {
            "@type": "cr:Field",
            "@id": "actions/item_id_a",
            "name": "item_id_a",
            "description": "First interacting entity identifier",
            "dataType": "sc:Text",
            "source": {
              "fileObject": {
                "@id": "#ACTIONS_PATH"
              },
              "extract": {
                "column": "item_id_a"
              }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "actions/item_id_b",
            "name": "item_id_b",
            "description": "Second interacting entity identifier",
            "dataType": "sc:Text",
            "source": {
              "fileObject": {
                "@id": "#ACTIONS_PATH"
              },
              "extract": {
                "column": "item_id_b"
              }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "actions/mode",
            "name": "mode",
            "description": "Interaction mode",
            "dataType": "sc:Text",
            "source": {
              "fileObject": {
                "@id": "#ACTIONS_PATH"
              },
              "extract": {
                "column": "mode"
              }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "actions/action",
            "name": "action",
            "description": "Specific action, when supplied",
            "dataType": "sc:Text",
            "source": {
              "fileObject": {
                "@id": "#ACTIONS_PATH"
              },
              "extract": {
                "column": "action"
              }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "actions/a_is_acting",
            "name": "a_is_acting",
            "description": "Source direction flag (t or f)",
            "dataType": "sc:Text",
            "source": {
              "fileObject": {
                "@id": "#ACTIONS_PATH"
              },
              "extract": {
                "column": "a_is_acting"
              }
            }
          },
          {
            "@type": "cr:Field",
            "@id": "actions/score",
            "name": "score",
            "description": "Interaction confidence score",
            "dataType": "sc:Integer",
            "source": {
              "fileObject": {
                "@id": "#ACTIONS_PATH"
              },
              "extract": {
                "column": "score"
              }
            }
          }
        ],
        "examples": [
          {
            "actions/item_id_a": "9606.ENSP00000170630",
            "actions/item_id_b": "CIDm00010461",
            "actions/mode": "expression",
            "actions/action": "",
            "actions/a_is_acting": "f",
            "actions/score": 150
          },
          {
            "actions/item_id_a": "CIDm00010461",
            "actions/item_id_b": "9606.ENSP00000170630",
            "actions/mode": "expression",
            "actions/action": "",
            "actions/a_is_acting": "t",
            "actions/score": 150
          }
        ]
      },
